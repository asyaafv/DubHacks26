# Production build: point VITE_API_BASE at the deployed backend, e.g.
#   VITE_API_BASE=https://lapse-api.onrender.com npm run build
# (a shell variable overrides this file). Defaults to localhost for the
# laptop-fallback demo.
VITE_API_BASE=http://localhost:8000
VITE_USE_MOCKS=false
VITE_DASHBOARD_URL=http://localhost:5173/dashboard
