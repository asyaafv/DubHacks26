# API origin baked into the bundle and the manifest host_permissions.
VITE_API_BASE=http://localhost:8000
# true forces shared/seed mock data (no backend). false (default) calls the API,
# with an automatic logged mock fallback only when the backend is unreachable.
VITE_USE_MOCKS=false
VITE_DASHBOARD_URL=http://localhost:5173/dashboard
