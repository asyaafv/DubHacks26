{
  "description": "A user-scoped savings history item; never contains a reward code.",
  "properties": {
    "reward_id": {
      "format": "uuid",
      "title": "Reward Id",
      "type": "string"
    },
    "merchant_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Merchant Name"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Description"
    },
    "saved": {
      "pattern": "^\\d+\\.\\d{2}$",
      "title": "Saved",
      "type": "string"
    },
    "redeemed_at": {
      "format": "date-time",
      "title": "Redeemed At",
      "type": "string"
    }
  },
  "required": [
    "reward_id",
    "merchant_name",
    "description",
    "saved",
    "redeemed_at"
  ],
  "title": "Redemption",
  "type": "object"
}