{
  "$defs": {
    "CardBase": {
      "description": "Payment card for cashback tracking.",
      "properties": {
        "issuer": {
          "description": "Card issuer",
          "examples": [
            "Chase"
          ],
          "title": "Issuer",
          "type": "string"
        },
        "network": {
          "$ref": "#/$defs/CardNetwork",
          "description": "Card network"
        },
        "name": {
          "description": "Card product name",
          "examples": [
            "Freedom Unlimited"
          ],
          "title": "Name",
          "type": "string"
        },
        "base_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Base cashback rate (%)",
          "examples": [
            "1.5"
          ],
          "title": "Base Rate"
        },
        "category_rates": {
          "description": "Bonus category rates",
          "items": {
            "$ref": "#/$defs/CategoryRate"
          },
          "title": "Category Rates",
          "type": "array"
        }
      },
      "required": [
        "issuer",
        "network",
        "name",
        "base_rate"
      ],
      "title": "CardBase",
      "type": "object"
    },
    "CardNetwork": {
      "description": "Payment card network.",
      "enum": [
        "visa",
        "mastercard",
        "amex",
        "discover"
      ],
      "title": "CardNetwork",
      "type": "string"
    },
    "CategoryRate": {
      "description": "Cashback rate for a specific category or MCC.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Category name",
          "examples": [
            "Dining"
          ],
          "title": "Category"
        },
        "mcc_codes": {
          "description": "Matching MCC codes",
          "items": {
            "type": "string"
          },
          "title": "Mcc Codes",
          "type": "array"
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Cashback rate (percentage)",
          "examples": [
            "3.0"
          ],
          "title": "Rate"
        }
      },
      "required": [
        "rate"
      ],
      "title": "CategoryRate",
      "type": "object"
    },
    "MembershipBase": {
      "description": "Store membership/loyalty program.",
      "properties": {
        "merchant_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Linked merchant ID",
          "title": "Merchant Id"
        },
        "merchant_name": {
          "description": "Merchant name",
          "examples": [
            "Costco"
          ],
          "title": "Merchant Name",
          "type": "string"
        },
        "program_name": {
          "description": "Membership program name",
          "examples": [
            "Executive"
          ],
          "title": "Program Name",
          "type": "string"
        },
        "tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Membership tier",
          "examples": [
            "Gold"
          ],
          "title": "Tier"
        },
        "member_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Membership number (encrypted)",
          "title": "Member Id"
        },
        "benefits": {
          "description": "Membership benefits",
          "items": {
            "type": "string"
          },
          "title": "Benefits",
          "type": "array"
        },
        "annual_reward_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Annual reward rate (%)",
          "title": "Annual Reward Rate"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Membership expiration",
          "title": "Expires At"
        }
      },
      "required": [
        "merchant_name",
        "program_name"
      ],
      "title": "MembershipBase",
      "type": "object"
    }
  },
  "description": "Wallet update payload.",
  "properties": {
    "add_cards": {
      "items": {
        "$ref": "#/$defs/CardBase"
      },
      "title": "Add Cards",
      "type": "array"
    },
    "remove_card_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Remove Card Ids",
      "type": "array"
    },
    "add_memberships": {
      "items": {
        "$ref": "#/$defs/MembershipBase"
      },
      "title": "Add Memberships",
      "type": "array"
    },
    "remove_membership_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Remove Membership Ids",
      "type": "array"
    }
  },
  "title": "WalletUpdate",
  "type": "object"
}