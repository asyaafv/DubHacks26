{
  "$defs": {
    "FieldConfidence": {
      "description": "Per-field extraction confidence scores.",
      "properties": {
        "value": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        },
        "expires_at": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Expires At",
          "type": "number"
        },
        "code": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Code",
          "type": "number"
        },
        "min_spend": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Spend",
          "type": "number"
        },
        "merchant": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Merchant",
          "type": "number"
        }
      },
      "title": "FieldConfidence",
      "type": "object"
    },
    "Reward": {
      "description": "Full reward record.",
      "properties": {
        "merchant_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Linked merchant ID",
          "title": "Merchant Id"
        },
        "merchant_name": {
          "description": "Merchant name",
          "examples": [
            "Target"
          ],
          "title": "Merchant Name",
          "type": "string"
        },
        "category": {
          "description": "Reward category",
          "examples": [
            "Department Stores"
          ],
          "title": "Category",
          "type": "string"
        },
        "mcc": {
          "description": "Merchant Category Code",
          "examples": [
            "5311"
          ],
          "title": "Mcc",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RewardKind",
          "description": "Type of reward"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Reward value (percentage or amount)",
          "examples": [
            "10.00"
          ],
          "title": "Value"
        },
        "currency": {
          "default": "USD",
          "description": "Currency code",
          "title": "Currency",
          "type": "string"
        },
        "min_spend": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum purchase to apply",
          "examples": [
            "50.00"
          ],
          "title": "Min Spend"
        },
        "max_discount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum discount cap",
          "examples": [
            "25.00"
          ],
          "title": "Max Discount"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Promo/reward code (encrypted at rest)",
          "title": "Code"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expiration datetime",
          "title": "Expires At"
        },
        "starts_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start datetime (if future)",
          "title": "Starts At"
        },
        "stackable": {
          "default": false,
          "description": "Can combine with other rewards",
          "title": "Stackable",
          "type": "boolean"
        },
        "exclusions": {
          "description": "Excluded items/categories",
          "items": {
            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        },
        "id": {
          "description": "Unique reward ID",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "user_id": {
          "description": "Owner user ID",
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/RewardSource",
          "description": "How this reward was extracted"
        },
        "source_email_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source email message ID",
          "title": "Source Email Id"
        },
        "field_confidence": {
          "$ref": "#/$defs/FieldConfidence"
        },
        "overall_confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Overall Confidence",
          "type": "number"
        },
        "status": {
          "$ref": "#/$defs/RewardStatus",
          "default": "active"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "merchant_name",
        "category",
        "mcc",
        "kind",
        "value",
        "id",
        "user_id",
        "source"
      ],
      "title": "Reward",
      "type": "object"
    },
    "RewardKind": {
      "description": "Type of reward/discount offered.",
      "enum": [
        "percent_off",
        "amount_off",
        "points",
        "free_item",
        "bogo",
        "cashback"
      ],
      "title": "RewardKind",
      "type": "string"
    },
    "RewardSource": {
      "description": "How the reward was extracted/created.",
      "enum": [
        "email_jsonld",
        "gliner",
        "regex",
        "manual",
        "seed"
      ],
      "title": "RewardSource",
      "type": "string"
    },
    "RewardStatus": {
      "description": "Current status of the reward.",
      "enum": [
        "active",
        "needs_review",
        "used",
        "expired"
      ],
      "title": "RewardStatus",
      "type": "string"
    }
  },
  "description": "A reward chosen by the stacking solver.",
  "properties": {
    "reward_id": {
      "format": "uuid",
      "title": "Reward Id",
      "type": "string"
    },
    "reward": {
      "$ref": "#/$defs/Reward"
    },
    "savings": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "description": "Savings from this reward",
      "title": "Savings"
    },
    "applied_order": {
      "description": "Order in which to apply",
      "title": "Applied Order",
      "type": "integer"
    }
  },
  "required": [
    "reward_id",
    "reward",
    "savings",
    "applied_order"
  ],
  "title": "ChosenReward",
  "type": "object"
}