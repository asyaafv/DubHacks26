{
  "$defs": {
    "Card": {
      "description": "Full card record.",
      "properties": {
        "issuer": {
          "description": "Card issuer",
          "examples": [
            "Chase"
          ],
          "title": "Issuer",
          "type": "string"
        },
        "network": {
          "$ref": "#/$defs/CardNetwork",
          "description": "Card network"
        },
        "name": {
          "description": "Card product name",
          "examples": [
            "Freedom Unlimited"
          ],
          "title": "Name",
          "type": "string"
        },
        "base_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Base cashback rate (%)",
          "examples": [
            "1.5"
          ],
          "title": "Base Rate"
        },
        "category_rates": {
          "description": "Bonus category rates",
          "items": {
            "$ref": "#/$defs/CategoryRate"
          },
          "title": "Category Rates",
          "type": "array"
        },
        "id": {
          "description": "Unique card ID",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "user_id": {
          "description": "Owner user ID",
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "last_four": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last 4 digits (display only)",
          "title": "Last Four"
        },
        "is_demo": {
          "default": false,
          "description": "Demo card flag",
          "title": "Is Demo",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "network",
        "name",
        "base_rate",
        "id",
        "user_id"
      ],
      "title": "Card",
      "type": "object"
    },
    "CardNetwork": {
      "description": "Payment card network.",
      "enum": [
        "visa",
        "mastercard",
        "amex",
        "discover"
      ],
      "title": "CardNetwork",
      "type": "string"
    },
    "CategoryRate": {
      "description": "Cashback rate for a specific category or MCC.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Category name",
          "examples": [
            "Dining"
          ],
          "title": "Category"
        },
        "mcc_codes": {
          "description": "Matching MCC codes",
          "items": {
            "type": "string"
          },
          "title": "Mcc Codes",
          "type": "array"
        },
        "rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Cashback rate (percentage)",
          "examples": [
            "3.0"
          ],
          "title": "Rate"
        }
      },
      "required": [
        "rate"
      ],
      "title": "CategoryRate",
      "type": "object"
    },
    "Membership": {
      "description": "Full membership record.",
      "properties": {
        "merchant_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Linked merchant ID",
          "title": "Merchant Id"
        },
        "merchant_name": {
          "description": "Merchant name",
          "examples": [
            "Costco"
          ],
          "title": "Merchant Name",
          "type": "string"
        },
        "program_name": {
          "description": "Membership program name",
          "examples": [
            "Executive"
          ],
          "title": "Program Name",
          "type": "string"
        },
        "tier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Membership tier",
          "examples": [
            "Gold"
          ],
          "title": "Tier"
        },
        "member_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Membership number (encrypted)",
          "title": "Member Id"
        },
        "benefits": {
          "description": "Membership benefits",
          "items": {
            "type": "string"
          },
          "title": "Benefits",
          "type": "array"
        },
        "annual_reward_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Annual reward rate (%)",
          "title": "Annual Reward Rate"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Membership expiration",
          "title": "Expires At"
        },
        "id": {
          "description": "Unique membership ID",
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "user_id": {
          "description": "Owner user ID",
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        },
        "is_active": {
          "default": true,
          "title": "Is Active",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "merchant_name",
        "program_name",
        "id",
        "user_id"
      ],
      "title": "Membership",
      "type": "object"
    }
  },
  "description": "User's complete wallet state.",
  "properties": {
    "user_id": {
      "description": "User ID",
      "format": "uuid",
      "title": "User Id",
      "type": "string"
    },
    "cards": {
      "description": "Payment cards",
      "items": {
        "$ref": "#/$defs/Card"
      },
      "title": "Cards",
      "type": "array"
    },
    "memberships": {
      "description": "Store memberships",
      "items": {
        "$ref": "#/$defs/Membership"
      },
      "title": "Memberships",
      "type": "array"
    },
    "active_rewards_count": {
      "default": 0,
      "description": "Number of active rewards",
      "title": "Active Rewards Count",
      "type": "integer"
    },
    "expiring_soon_count": {
      "default": 0,
      "description": "Rewards expiring in 3 days",
      "title": "Expiring Soon Count",
      "type": "integer"
    }
  },
  "required": [
    "user_id"
  ],
  "title": "Wallet",
  "type": "object"
}