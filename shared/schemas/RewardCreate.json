{
  "$defs": {
    "FieldConfidence": {
      "description": "Per-field extraction confidence scores.",
      "properties": {
        "value": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        },
        "expires_at": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Expires At",
          "type": "number"
        },
        "code": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Code",
          "type": "number"
        },
        "min_spend": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Spend",
          "type": "number"
        },
        "merchant": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Merchant",
          "type": "number"
        }
      },
      "title": "FieldConfidence",
      "type": "object"
    },
    "RewardKind": {
      "description": "Type of reward/discount offered.",
      "enum": [
        "percent_off",
        "amount_off",
        "points",
        "free_item",
        "bogo",
        "cashback"
      ],
      "title": "RewardKind",
      "type": "string"
    },
    "RewardSource": {
      "description": "How the reward was extracted/created.",
      "enum": [
        "email_jsonld",
        "gliner",
        "regex",
        "manual",
        "seed"
      ],
      "title": "RewardSource",
      "type": "string"
    }
  },
  "description": "Reward creation payload.",
  "properties": {
    "merchant_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Linked merchant ID",
      "title": "Merchant Id"
    },
    "merchant_name": {
      "description": "Merchant name",
      "examples": [
        "Target"
      ],
      "title": "Merchant Name",
      "type": "string"
    },
    "category": {
      "description": "Reward category",
      "examples": [
        "Department Stores"
      ],
      "title": "Category",
      "type": "string"
    },
    "mcc": {
      "description": "Merchant Category Code",
      "examples": [
        "5311"
      ],
      "title": "Mcc",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/RewardKind",
      "description": "Type of reward"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "description": "Reward value (percentage or amount)",
      "examples": [
        "10.00"
      ],
      "title": "Value"
    },
    "currency": {
      "default": "USD",
      "description": "Currency code",
      "title": "Currency",
      "type": "string"
    },
    "min_spend": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Minimum purchase to apply",
      "examples": [
        "50.00"
      ],
      "title": "Min Spend"
    },
    "max_discount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Maximum discount cap",
      "examples": [
        "25.00"
      ],
      "title": "Max Discount"
    },
    "code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Promo/reward code (encrypted at rest)",
      "title": "Code"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Expiration datetime",
      "title": "Expires At"
    },
    "starts_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Start datetime (if future)",
      "title": "Starts At"
    },
    "stackable": {
      "default": false,
      "description": "Can combine with other rewards",
      "title": "Stackable",
      "type": "boolean"
    },
    "exclusions": {
      "description": "Excluded items/categories",
      "items": {
        "type": "string"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/RewardSource",
      "default": "manual"
    },
    "source_email_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Email Id"
    },
    "field_confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/FieldConfidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "merchant_name",
    "category",
    "mcc",
    "kind",
    "value"
  ],
  "title": "RewardCreate",
  "type": "object"
}